<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.believe</groupId>
        <artifactId>believe-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>believe-common-log</artifactId>
    <packaging>jar</packaging>

    <name>Believe Common Log</name>
    <description>日志链路追踪、MDC、请求日志切面</description>

    <dependencies>
        <dependency>
            <groupId>com.believe</groupId>
            <artifactId>believe-common-core</artifactId>
        </dependency>

        <!-- 直接引入Spring AOP的核心能力 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
        </dependency>

        <!-- 引入AspectJ框架，实际执行切面的库 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- Servlet API - 用于 MDC 和 Web 切面 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
